{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "coding",
  "agents": {
    "local": {
      "description": "Local coding assistant",
      "mode": "primary",
      "model": "ollama/qwen3.5:4b"
    },
    "coding": {
      "description": "Affordable cloud coding",
      "mode": "primary",
      "model": "openai/gpt-6-luna"
    },
    "advanced": {
      "description": "Complex coding and debugging",
      "mode": "primary",
      "model": "openai/gpt-6.1-sol"
    },
    "reviewer": {
      "description": "Independent code reviewer",
      "mode": "subagent",
      "model": "openai/gpt-6-luna",
      "permissions": [
        {
          "action": "edit",
          "resource": "*",
          "effect": "deny"
        },
        {
          "action": "shell",
          "resource": "*",
          "effect": "deny"
        }
      ]
    }
  }
}